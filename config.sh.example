#!/usr/bin/env bash
# KiroCrew Sync Configuration
# Copy this file to config.sh and customize

# Storage backend: gdrive, s3, rsync, local, or custom
export SYNC_BACKEND="gdrive"

# KiroCrew data directory (override if non-standard)
export KIROCREW_DIR="$HOME/.kiro/crew"

# Sync scope: "personal" (default) syncs everything between your own machines.
# "team" shares a knowledge library with colleagues and holds back chat
# transcripts, episodic memory and per-person config -- see README, Team Scope.
# Each scope keeps its own sync repo, so one machine can do both with two
# config files. Set it here rather than typing --team, so it cannot be missed.
export SYNC_SCOPE="personal"

# Knowledge path portability
# Folder sources are rewritten to a machine-independent form on push and back
# to this machine's paths on pull. Set to 0 to sync URIs verbatim.
export SYNC_PORTABLE_PATHS=1

# Where this machine declares its own locations (see path_map.conf.example).
# Machine-specific by design -- this file is never synced.
export KIROCREW_PATH_MAP="$KIROCREW_DIR/path_map.conf"

# Backend-specific settings
# Every backend reads the environment before its own defaults, so these can be
# exported here rather than edited into backends/${SYNC_BACKEND}.sh

# Google Drive settings (edit backends/gdrive.sh)
# - GDRIVE_REMOTE_NAME: rclone remote name (default: kirocrew-gdrive)
# - GDRIVE_SYNC_DIR: folder name in Google Drive (default: KiroCrew-Sync)

# S3 settings (set them here; the backend reads the environment first)
# - S3_BUCKET: your S3 bucket name
# - S3_PREFIX: prefix/folder in bucket (default: kirocrew-sync)
# - AWS_PROFILE: AWS CLI profile name (default: default)
# - S3_ENDPOINT_URL: S3-compatible endpoint; empty (default) means AWS S3
# - S3_REGION: region passed to every call; empty (default) leaves it to the profile
# The same backend drives any S3-compatible store. Cloudflare R2 below; its
# keys live in the AWS_PROFILE profile like any others -- docs/backends/s3.md:
# export S3_BUCKET="kirocrew-state"
# export AWS_PROFILE="r2"
# export S3_ENDPOINT_URL="https://<account-id>.r2.cloudflarestorage.com"
# export S3_REGION="auto"

# Rsync settings (edit backends/rsync.sh)
# - RSYNC_HOST: user@hostname
# - RSYNC_PATH: remote directory path

# Local directory settings (edit backends/local.sh) — Dropbox, Syncthing, NAS, USB
# - LOCAL_SYNC_DIR: shared folder path (default: $HOME/Dropbox/KiroCrew-Sync)
